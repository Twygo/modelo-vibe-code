# Copie este arquivo para .env (cp .env.example .env). O .env NUNCA vai pro Git.

# Banco de dados (Postgres local, dentro do Docker).
# O backend monta a conexão a partir destas 3 variáveis (ver docker-compose.yml).
# ATENÇÃO: se mudar a senha depois de já ter subido o sistema uma vez,
# rode `make reset` (apaga os dados do banco local) para valer a nova senha.
POSTGRES_USER=kpi
POSTGRES_PASSWORD=kpi
POSTGRES_DB=kpidb

# Para onde o frontend (Vite) encaminha as chamadas /api. Não precisa mexer.
VITE_API_TARGET=http://backend:8000

# Integração com a API da Twygo (opcional). Deixe vazio se não for usar.
# É um segredo: fica só aqui no .env, nunca no código nem no Git.
TWYGO_API_TOKEN=

# ---------------------------------------------------------------------------
# Estas variáveis são pro docker-compose.yml de DESENVOLVIMENTO. Em produção
# (docker-compose.dokploy.yml, ver .claude/skills/publicar-dokploy/), as
# mesmas POSTGRES_* continuam valendo, mas DATABASE_URL é montada sozinha a
# partir delas, e VITE_API_TARGET não existe — quem serve o front é o nginx,
# que já sabe proxiar /api pro backend (frontend/nginx.conf). Não deixe este
# arquivo virar a fonte de verdade da produção: no Dokploy as variáveis vêm
# do próprio painel, nunca de um .env versionado.
CORS_ORIGINS=
