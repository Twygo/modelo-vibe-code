# Só usado ao rodar o backend FORA do Docker (caso de dev).
# Com `make up` isso é ignorado: o docker-compose.yml monta a conexão a partir do .env da raiz.
# Para funcionar, descomente a porta "127.0.0.1:5433:5432" do postgres no docker-compose.yml.
DATABASE_URL=postgresql+psycopg://kpi:kpi@localhost:5433/kpidb
